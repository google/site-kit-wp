exports[`FeatureDetailRequirements should render effort, service requirements, checklist and external help links 1`] = `
<div>
  <div
    class="googlesitekit-feature-details-panel__text"
  >
    <section
      class="googlesitekit-feature-details-panel__section"
    >
      <h3
        class="googlesitekit-typography googlesitekit-typography--label googlesitekit-typography--large"
      >
        Setup Effort
      </h3>
      <div
        class="googlesitekit-effort-indicator"
      >
        <div
          aria-hidden="true"
          class="googlesitekit-effort-indicator__icons"
        >
          <svg />
          <svg />
          <svg />
        </div>
        <span
          class="googlesitekit-typography googlesitekit-effort-indicator__label googlesitekit-typography--body googlesitekit-typography--medium"
