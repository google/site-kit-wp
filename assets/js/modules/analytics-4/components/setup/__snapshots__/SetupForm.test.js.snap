            tabindex="0"
          >
            Main datastream (G-155BC2366E)
          </div>
          <div
            class="mdc-notched-outline mdc-notched-outline--upgraded mdc-notched-outline--notched"
          >
            <div
              class="mdc-notched-outline__leading"
            />
            <div
              class="mdc-notched-outline__notch"
            >
              <label
                class="mdc-floating-label mdc-floating-label--float-above"
                for="googlesitekit-select-2"
                style=""
              >
                Web data stream
              </label>
            </div>
            <div
              class="mdc-notched-outline__trailing"
            />
          </div>
        </div>
        <div
          class="googlesitekit-setup__step-hint"
        >
          <p
            class="googlesitekit-typography googlesitekit-typography--body googlesitekit-typography--small"
          >
            What is a web data stream?
          </p>
          <span
            aria-labelledby="googlesitekit-info-tooltip-label-1"
            class="googlesitekit-info-tooltip"
            role="button"
            tabindex="0"
          >
            <svg />
            <span
              hidden=""
              id="googlesitekit-info-tooltip-label-1"
            >
              A data stream is a flow of data from your visitors to Analytics. When a data stream is created, Analytics generates a snippet of code that is added to your site to collect that data. 
              <a
                aria-label="Learn more (opens in a new tab)"
                class="googlesitekit-cta-link"
                href="https://sitekit.withgoogle.com/support/?doc=what-is-ga4-data-stream"
                rel="noopener noreferrer"
                target="_blank"
              >
                <span
                  class="googlesitekit-cta-link__contents"
                >
                  Learn more
                </span>
              </a>
            </span>
          </span>
        </div>
      </div>
    </div>
    <div
      class="googlesitekit-analytics-enable-enhanced-measurement"
    >
      <div
        aria-checked="true"
        class="mdc-switch mdc-switch--checked"
        role="switch"
        tabindex="0"
      >
        <div
          class="mdc-switch__track"
        >
           
        </div>
        <div
          class="mdc-switch__thumb-underlay"
        >
          <div
            class="mdc-switch__thumb"
          >
            <input
              checked=""
              class="mdc-switch__native-control"
              id="googlesitekit-switch-0"
              readonly=""
              role="switch"
              type="checkbox"
            />
          </div>
        </div>
      </div>
      <label
        class=""
        for="googlesitekit-switch-0"
      >
        Enable enhanced measurement
      </label>
      <p
        class="googlesitekit-typography googlesitekit-module-settings-group__helper-text googlesitekit-typography--body googlesitekit-typography--small"
      >
        This allows you to measure interactions with your content (e.g. file downloads, form completions, video views). 
        <a
          aria-label="Learn more (opens in a new tab)"
          class="googlesitekit-cta-link"
          href="https://support.google.com/analytics/answer/9216061?hl=en-US"
          rel="noopener noreferrer"
          target="_blank"
        >
          <span
            class="googlesitekit-cta-link__contents"
          >
            Learn more
          </span>
          <span
            class="googlesitekit-icon-wrapper"
            style="margin-left: 5px;"
          >
            <svg />
          </span>
        </a>
      </p>
    </div>
    <div
      class="googlesitekit-setup-module__action"
    >
      <button
        class="mdc-button googlesitekit-button-icon--spinner googlesitekit-button-icon--spinner__after mdc-button--raised"
        target="_self"
      >
        <span
          class="mdc-button__label"
        >
          Set up
        </span>
      </button>
    </div>
  </form>
</div>
`;

