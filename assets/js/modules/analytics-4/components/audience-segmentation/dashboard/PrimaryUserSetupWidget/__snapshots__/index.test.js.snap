exports[`PrimaryUserSetupWidget should handle the insufficient permissions error 1`] = `
<div>
  <div
    class="googlesitekit-widget googlesitekit-widget--keyMetricsAddMetric googlesitekit-widget--no-padding googlesitekit-audience-segmentation-setup-error-widget"
  >
    <div
      class="googlesitekit-widget__body"
    >
      <div
        class="googlesitekit-notice-container"
      >
        <div
          class="googlesitekit-notice googlesitekit-notice--error googlesitekit-notice--default"
          role="status"
        >
          <div
            class="googlesitekit-notice__icon"
          >
            <svg />
          </div>
          <div
            class="googlesitekit-typography googlesitekit-notice__content googlesitekit-typography--body googlesitekit-typography--medium"
          >
            <p
              class="googlesitekit-typography googlesitekit-notice__title googlesitekit-typography--label googlesitekit-typography--medium"
            >
              Visitor groups setup failed
            </p>
            <p
              class="googlesitekit-typography googlesitekit-notice__description googlesitekit-typography--body googlesitekit-typography--medium"
            >
              It seems that you don’t have the required permissions to set up visitor groups.
              <br />
              You can contact your administrator. 
              <a
                aria-label="Learn more (opens in a new tab)"
                class="googlesitekit-cta-link"
                href="undefined?doc=visitor-groups"
                rel="noopener noreferrer"
                target="_blank"
              >
                <span
                  class="googlesitekit-cta-link__contents"
                >
                  Learn more
                </span>
              </a>
            </p>
          </div>
          <div
            class="googlesitekit-notice__action"
          >
            <button
              class="mdc-button mdc-button--tertiary"
              target="_self"
            >
              <span
                class="mdc-button__label"
              >
                No thanks
              </span>
            </button>
            <button
              class="mdc-button googlesitekit-notice__cta googlesitekit-button-icon--spinner googlesitekit-button-icon--spinner__after mdc-button--raised"
              target="_self"
            >
              <span
                class="mdc-button__label"
              >
                Retry
              </span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;

